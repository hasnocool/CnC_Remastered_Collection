+    #[test]
+    fn defence_fires_projectile_not_direct_damage() {
+        let mut game = Game::new("defence", 32, 32);
+        let tower = add_defence(&mut game, 0, StructureType::GuardTower, Vec2i::new(10, 10));
+
+        let mut enemy = Unit::new(UnitType::Jeep, Game::cell_center(12, 10), 1);
+        enemy.health = enemy.max_health;
+        let before = enemy.health;
+        let enemy_index = game.units.len();
+        game.units.push(enemy);
+
+        // Fire: a projectile must spawn, but the target must NOT take damage yet.
+        game.update_defence_combat(Fixed16_16::from_int(1));
+
+        assert!(
+            !game.projectiles.is_empty(),
+            "defence must spawn a projectile, not apply damage directly"
+        );
+        assert_eq!(
+            game.units[enemy_index].health, before,
+            "damage must apply on projectile arrival, not on the fire tick"
+        );
+        assert!(
+            game.buildings[tower].reload > Fixed16_16::ZERO,
+            "firing must start the reload timer"
+        );
+
+        // Advance until the projectile arrives.
+        for _ in 0..200 {
+            game.update_projectiles(Fixed16_16::from_f32(0.05));
+            if game.units[enemy_index].health < before {
+                break;
+            }
+        }
+
+        assert!(
+            game.units[enemy_index].health < before,
+            "the target must take damage after the projectile arrives"
+        );
+        assert!(
+            game.projectiles.is_empty(),
+            "the projectile must be consumed on impact"
         );
     }
 
